{
  "version": 1,
  "hooks": {
    "preCompact": [
      {
        "command": "scripts/hook_pre_compact.sh",
        "timeout": 30,
        "type": "command"
      }
    ],
    "preToolUse": [
      {
        "command": "scripts/hook_pre_compact.sh",
        "timeout": 15,
        "type": "command"
      }
    ],
    "sessionStart": [
      {
        "command": "scripts/hook_session_start.sh",
        "timeout": 30,
        "type": "command"
      }
    ],
    "agentStop": [
      {
        "command": "scripts/hook_pre_compact.sh",
        "timeout": 30,
        "type": "command"
      }
    ],
    "userPromptSubmitted": [
      {
        "command": "scripts/hook_user_prompt_submit.sh",
        "timeout": 15,
        "type": "command"
      }
    ]
  }
}
